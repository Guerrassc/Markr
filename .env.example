# Copy to .env (git-ignored). Never commit real API keys.
# Provider used for the recorded M2 experiment:
MARKR_PROVIDER=gemini
GEMINI_API_KEY=
MARKR_MODEL_SMALL=gemini-3.5-flash-lite
MARKR_MODEL_LARGE=gemini-3.8-flash
# Optional alternatives supported by experiments/m2_extraction/llm.py:
# MARKR_PROVIDER=anthropic | openai | ollama
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_HOST=http://localhost:11434
