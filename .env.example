# Copy to .env (git-ignored) and fill in. Never commit real keys.
# MARKR_PROVIDER options: anthropic | openai | gemini | ollama
MARKR_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
MARKR_MODEL_SMALL=claude-haiku-5-5
MARKR_MODEL_LARGE=claude-sonnet-5-5
